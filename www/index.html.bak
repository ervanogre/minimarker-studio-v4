<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>MINIMARKER STUDIO V4</title>
  <script src="libs/dxf-parser.js"></script>
  <script src="libs/xlsx.full.min.js"></script>
  <script src="libs/jspdf.umd.min.js"></script>
  <script src="libs/jszip.min.js"></script>
  <style>
    :root {
      --bg: #07060e;
      --card: #110f21;
      --neon-cyan: #00f5d4;
      --neon-pink: #ff007f;
      --neon-yellow: #fee440;
      --neon-purple: #9b5de5;
      --text: #f8fafc;
      --muted: #a5b4fc;
    }
    * { box-sizing: border-box; font-family: 'Segoe UI', system-ui, sans-serif; }
    body {
      margin: 0; color: var(--text); padding: 12px;
      background-color: var(--bg);
      background-image:
        radial-gradient(circle at 15% 15%, rgba(255, 0, 127, 0.16), transparent 40%),
        radial-gradient(circle at 85% 25%, rgba(0, 245, 212, 0.14), transparent 42%),
        radial-gradient(circle at 50% 90%, rgba(155, 93, 229, 0.18), transparent 45%);
      min-height: 100vh;
    }
    .hidden { display: none !important; }

    /* Layar Awal Graffiti Neon */
    .splash-wrap {
      min-height: 92vh; display: flex; flex-direction: column;
      justify-content: center; align-items: center; text-align: center; padding: 18px;
    }
    .graffiti-badge {
      display: inline-block; padding: 5px 14px; border-radius: 999px;
      border: 1px solid var(--neon-yellow); color: var(--neon-yellow);
      font-size: 11px; font-weight: 900; letter-spacing: 2px; margin-bottom: 14px;
      box-shadow: 0 0 12px rgba(254, 228, 64, 0.35);
    }
    .graffiti-title {
      font-size: 34px; font-weight: 900; font-style: italic; letter-spacing: 1.5px;
      line-height: 1.1; margin: 0 0 10px 0; text-transform: uppercase;
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-yellow), var(--neon-pink));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 14px rgba(0, 245, 212, 0.45));
      transform: skewX(-5deg);
    }
    .graffiti-creator {
      font-size: 13px; font-weight: 800; letter-spacing: 2.5px;
      color: var(--neon-pink); text-shadow: 0 0 10px rgba(255, 0, 127, 0.7);
      margin-bottom: 34px; text-transform: uppercase;
    }
    .splash-btn-group { width: 100%; max-width: 360px; display: flex; flex-direction: column; gap: 14px; }

    /* Tombol & Kartu Tema Graffiti Neon */
    .btn {
      width: 100%; padding: 13px 14px; border-radius: 12px;
      border: 2px solid var(--neon-cyan);
      background: linear-gradient(135deg, rgba(0, 245, 212, 0.2), rgba(155, 93, 229, 0.25));
      color: #ffffff; font-size: 14px; font-weight: 900; letter-spacing: 0.8px;
      text-transform: uppercase; cursor: pointer;
      box-shadow: 0 0 15px rgba(0, 245, 212, 0.35), inset 0 0 8px rgba(0, 245, 212, 0.2);
      transition: transform 0.12s, box-shadow 0.12s;
    }
    .btn:active { transform: scale(0.97); }
    .btn-pink {
      border-color: var(--neon-pink);
      background: linear-gradient(135deg, rgba(255, 0, 127, 0.28), rgba(155, 93, 229, 0.28));
      box-shadow: 0 0 16px rgba(255, 0, 127, 0.45), inset 0 0 8px rgba(255, 0, 127, 0.25);
    }
    .btn-secondary {
      border-color: var(--neon-yellow);
      background: rgba(254, 228, 64, 0.1);
      color: var(--neon-yellow);
      box-shadow: 0 0 12px rgba(254, 228, 64, 0.25);
    }
    .card {
      background: var(--card); border: 1.5px solid rgba(0, 245, 212, 0.35);
      border-radius: 14px; padding: 12px; margin-bottom: 12px;
      box-shadow: 0 0 16px rgba(155, 93, 229, 0.18);
    }
    .card-title {
      font-size: 14px; font-weight: 900; color: var(--neon-cyan);
      text-transform: uppercase; letter-spacing: 0.6px;
      text-shadow: 0 0 8px rgba(0, 245, 212, 0.4);
    }
    .card-sub { font-size: 11px; color: var(--muted); margin-top: 3px; }
    .card-row { display: flex; justify-content: space-between; align-items: center; }

    .tabs { display: flex; gap: 8px; margin-bottom: 12px; }
    .tab-btn {
      flex: 1; padding: 10px; border-radius: 10px; border: 1.5px solid #2e294e;
      background: #110f21; color: var(--muted); font-weight: 800; font-size: 12px;
      text-transform: uppercase; cursor: pointer;
    }
    .tab-btn.active {
      border-color: var(--neon-pink); color: #fff;
      background: rgba(255, 0, 127, 0.22);
      box-shadow: 0 0 12px rgba(255, 0, 127, 0.45);
    }
    .dropzone {
      border: 2px dashed var(--neon-purple); border-radius: 12px; padding: 14px;
      text-align: center; margin-bottom: 10px; cursor: pointer;
      background: rgba(155, 93, 229, 0.08);
    }
    .dropzone.loaded {
      border-color: var(--neon-cyan); border-style: solid;
      background: rgba(0, 245, 212, 0.1);
      box-shadow: 0 0 12px rgba(0, 245, 212, 0.25);
    }
    input[type="text"], input[type="number"], select {
      width: 100%; padding: 9px 10px; border-radius: 8px;
      border: 1.5px solid #312e59; background: #090814; color: #fff;
      font-size: 13px; margin-bottom: 8px;
    }
    input:focus, select:focus { outline: none; border-color: var(--neon-cyan); box-shadow: 0 0 8px rgba(0,245,212,0.4); }
    .piece-item { border-bottom: 1px solid #231f42; display: flex; }
    #markerContainer canvas { width: 100%; height: auto; border-radius: 8px; background: #fff; display: block; }

    @keyframes neonPulse {
      0%, 100% { filter: drop-shadow(0 0 12px rgba(0,245,212,0.55)); transform: skewX(-5deg) scale(1); }
      50% { filter: drop-shadow(0 0 24px rgba(255,0,127,0.85)); transform: skewX(-5deg) scale(1.03); }
    }
    .graffiti-title { animation: neonPulse 3.2s ease-in-out infinite; }
    #homeSplashScreen { position: relative; overflow: hidden; }
    #screensaverCanvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
    #homeSplashScreen > *:not(canvas) { position: relative; z-index: 1; }
  </style>
<style>.autosync-active #btnGoToMenu2 { display: none !important; }</style>
</head>
<body>
  <!-- LAYAR AWAL (SPLASH SCREEN) -->
  <div id="homeSplashScreen" class="splash-wrap">
    <canvas id="screensaverCanvas"></canvas>
    <div class="graffiti-badge">⚡ STREET CAD EDITION ⚡</div>
    <h1 class="graffiti-title">MINIMARKER STUDIO V4</h1>
    <div class="graffiti-creator">CREATED BY ERVAN ALVIAN</div>
    <div class="splash-btn-group">
      <button type="button" class="btn" onclick="openToolMode('manual')">🎨 1. BUAT MINIMARKER</button>
      <button type="button" class="btn btn-pink" onclick="openToolMode('autosync')">⚡ 2. MINIMARKER AUTO SYNC</button>
    </div>
  </div>
  <!-- WORKSPACE UTAMA -->
  <div id="mainAppScreen" class="hidden" style="padding-bottom:76px;">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; padding-bottom:8px; border-bottom:1.5px solid rgba(255,0,127,0.4);">
      <div>
        <div style="font-size:16px; font-weight:900; font-style:italic; color:var(--neon-cyan); text-shadow:0 0 8px rgba(0,245,212,0.5);">MINIMARKER STUDIO V4</div>
        <div style="font-size:10px; font-weight:700; color:var(--neon-pink); letter-spacing:1px;">BY ERVAN ALVIAN</div>
      </div>
      <button type="button" onclick="backToSplash()" style="background:rgba(254,228,64,0.12); color:var(--neon-yellow); border:1.5px solid var(--neon-yellow); border-radius:8px; padding:6px 10px; font-size:11px; font-weight:900; cursor:pointer;">🏠 HOME</button>
    </div>

    <div id="autoSyncBanner" class="card hidden" style="border-color:var(--neon-pink); background:rgba(255,0,127,0.12); box-shadow:0 0 20px rgba(255,0,127,0.3);">
      <div class="card-title" style="color:var(--neon-pink);">⚡ MINIMARKER AUTO SYNC ENGINE</div>
      <div class="card-sub" style="color:#f8fafc; margin-bottom:10px;">1. Unggah DXF &amp; Excel BOM di bawah.<br>2. Unggah file <strong>Planning Spread (Final Fabric)</strong> di kotak khusus ini agar semua Colorway disinkronkan via <strong>F/A</strong>:</div>

      <div class="dropzone" id="spreadZone" style="border-color:var(--neon-yellow); background:rgba(254,228,64,0.08); margin-bottom:8px;" onclick="document.getElementById('spreadInput').click()">
        <input type="file" id="spreadInput" accept=".csv,.xlsx,.xls" class="hidden" onchange="handlePlanningSpreadUpload(event)" />
        <div id="spreadStatus" style="font-size:13px; font-weight:800; color:var(--neon-yellow);">📋 PLANNING SPREAD JANSPORT (.CSV/.XLSX)</div>
      </div>
      <div class="dropzone" id="spreadReiZone" style="border-color:var(--neon-cyan); background:rgba(0,245,212,0.08); margin-bottom:10px;" onclick="document.getElementById('spreadReiInput').click()">
        <input type="file" id="spreadReiInput" accept=".csv,.xlsx,.xls" class="hidden" onchange="handlePlanningReiUpload(event)" />
        <div id="spreadReiStatus" style="font-size:13px; font-weight:800; color:var(--neon-cyan);">🏔️ PLANNING SPREAD REI (.CSV/.XLSX)</div>
      </div>

      <div style="display:flex; gap:8px;">
        <button type="button" class="btn btn-pink" style="flex:1; padding:11px; font-size:13px;" onclick="runAutoSyncOnly()">⚡ 1. AUTO SYNC</button>
        <button type="button" class="btn" style="flex:1.2; padding:11px; font-size:13px;" onclick="saveAllColorwaysBatch()">💾 2. SAVE SEMUA (ZIP)</button>
      </div>
      <div id="autoSyncLog" class="hidden" style="margin-top:10px; padding:8px 10px; background:#07060e; border:1px solid var(--neon-cyan); border-radius:8px; font-size:11px; color:var(--neon-cyan); max-height:150px; overflow-y:auto;"></div>
    </div>

    <div class="tabs">
      <button id="tabUpload" class="tab-btn active" onclick="switchTab('upload')">📤 Upload &amp; Proses</button>
      <button id="tabDownloads" class="tab-btn" onclick="switchTab('downloads')">📥 Download</button>
      <button id="tabManual" class="tab-btn" onclick="switchTab('manual')">🏷️ Luar Line &amp; Manual</button>
    </div>

    <div id="panelUpload">
      <div class="card">
        <div class="dropzone" id="dxfZone" onclick="document.getElementById('dxfInput').click()">
          <input type="file" id="dxfInput" accept=".dxf" class="hidden" onchange="handleDxfUpload(event)" />
          <div id="dxfStatus" style="font-size:13px; font-weight:700;">📐 Ketuk untuk Unggah File Pola (.DXF)</div>
        </div>
        <div class="dropzone" id="excelZone" onclick="document.getElementById('excelInput').click()">
          <input type="file" id="excelInput" accept=".xlsx,.xls,.csv" class="hidden" onchange="handleExcelUpload(event)" />
          <div id="excelStatus" style="font-size:13px; font-weight:700;">📊 Ketuk untuk Unggah BOM Excel (.XLSX/.CSV)</div>
        </div>
        <div id="colorwayBox" class="hidden">
          <label style="font-size:11px; color:var(--neon-cyan); font-weight:700;">PILIH COLORWAY:</label>
          <select id="colorwaySelect" onchange="applyColorwayMapping()"></select>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
          <div>
            <label style="font-size:11px; color:var(--muted);">STYLE NO:</label>
            <input type="text" id="styleNoInput" placeholder="JS0A47JK" />
          </div>
          <div>
            <label style="font-size:11px; color:var(--muted);">ORDER NO:</label>
            <input type="text" id="orderNoInput" placeholder="KT26JN022" />
          </div>
        </div>
      </div>
      <div class="card">
        <div id="fontGridCard" class="card-title" style="margin-bottom:8px;">🎛️ Pengaturan Font &amp; Grid A4</div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
<div><label style="font-size:11px;color:var(--muted);">JENIS FONT:</label><select id="fontFamilySelect" onchange="stepSelectVal('fontFamilySelect',0)"><option value='"Times New Roman", serif'>Times New Roman</option><option value='Arial, Helvetica, sans-serif'>Arial</option><option value='"Courier New", monospace'>Courier</option><option value='Georgia, serif'>Georgia</option></select></div>
<div><label style="font-size:11px;color:var(--muted);">JUDUL HEADER:</label><div style="display:flex;gap:4px;"><button type="button" onclick="stepFontVal('titleFontSize',-2)" style="padding:7px 10px;background:#07060e;color:var(--neon-cyan);border:1px solid var(--neon-cyan);border-radius:6px;font-weight:900;">-</button><input type="number" id="titleFontSize" value="38" min="18" max="72" style="text-align:center;margin:0;" onchange="stepFontVal('titleFontSize',0)"/><button type="button" onclick="stepFontVal('titleFontSize',2)" style="padding:7px 10px;background:#07060e;color:var(--neon-cyan);border:1px solid var(--neon-cyan);border-radius:6px;font-weight:900;">+</button></div></div>
<div><label style="font-size:11px;color:var(--muted);">TEKS POLA:</label><div style="display:flex;gap:4px;"><button type="button" onclick="stepFontVal('labelFontSize',-1)" style="padding:7px 10px;background:#07060e;color:var(--neon-yellow);border:1px solid var(--neon-yellow);border-radius:6px;font-weight:900;">-</button><input type="number" id="labelFontSize" value="14" min="8" max="36" style="text-align:center;margin:0;" onchange="stepFontVal('labelFontSize',0)"/><button type="button" onclick="stepFontVal('labelFontSize',1)" style="padding:7px 10px;background:#07060e;color:var(--neon-yellow);border:1px solid var(--neon-yellow);border-radius:6px;font-weight:900;">+</button></div></div>
<div><label style="font-size:11px;color:var(--muted);">LUAR LINE:</label><div style="display:flex;gap:4px;"><button type="button" onclick="stepFontVal('processFontSize',-1)" style="padding:7px 10px;background:#07060e;color:var(--neon-pink);border:1px solid var(--neon-pink);border-radius:6px;font-weight:900;">-</button><input type="number" id="processFontSize" value="13" min="8" max="36" style="text-align:center;margin:0;" onchange="stepFontVal('processFontSize',0)"/><button type="button" onclick="stepFontVal('processFontSize',1)" style="padding:7px 10px;background:#07060e;color:var(--neon-pink);border:1px solid var(--neon-pink);border-radius:6px;font-weight:900;">+</button></div></div>
<div><label style="font-size:11px;color:var(--muted);">KET. FABRIC:</label><div style="display:flex;gap:4px;"><button type="button" onclick="stepFontVal('fabricFontSize',-1)" style="padding:7px 10px;background:#07060e;color:var(--neon-cyan);border:1px solid var(--neon-cyan);border-radius:6px;font-weight:900;">-</button><input type="number" id="fabricFontSize" value="14" min="8" max="36" style="text-align:center;margin:0;" onchange="stepFontVal('fabricFontSize',0)"/><button type="button" onclick="stepFontVal('fabricFontSize',1)" style="padding:7px 10px;background:#07060e;color:var(--neon-cyan);border:1px solid var(--neon-cyan);border-radius:6px;font-weight:900;">+</button></div></div>
<div><label style="font-size:11px;color:var(--muted);">KOLOM:</label><div style="display:flex;gap:4px;"><button type="button" onclick="stepSelectVal('colsSelect',-1)" style="padding:7px 10px;background:#07060e;color:var(--neon-yellow);border:1px solid var(--neon-yellow);border-radius:6px;font-weight:900;">-</button><select id="colsSelect" style="flex:1;margin:0;" onchange="stepSelectVal('colsSelect',0)"><option value="auto">Auto</option><option value="4">4 Kolom</option><option value="5">5 Kolom</option><option value="6">6 Kolom</option><option value="7">7 Kolom</option><option value="8">8 Kolom</option></select><button type="button" onclick="stepSelectVal('colsSelect',1)" style="padding:7px 10px;background:#07060e;color:var(--neon-yellow);border:1px solid var(--neon-yellow);border-radius:6px;font-weight:900;">+</button></div></div>
<div><label style="font-size:11px;color:var(--muted);">BARIS:</label><div style="display:flex;gap:4px;"><button type="button" onclick="stepSelectVal('rowsSelect',-1)" style="padding:7px 10px;background:#07060e;color:var(--neon-pink);border:1px solid var(--neon-pink);border-radius:6px;font-weight:900;">-</button><select id="rowsSelect" style="flex:1;margin:0;" onchange="stepSelectVal('rowsSelect',0)"><option value="auto">Auto</option><option value="2">2 Baris</option><option value="3">3 Baris</option><option value="4">4 Baris</option><option value="5">5 Baris</option></select><button type="button" onclick="stepSelectVal('rowsSelect',1)" style="padding:7px 10px;background:#07060e;color:var(--neon-pink);border:1px solid var(--neon-pink);border-radius:6px;font-weight:900;">+</button></div></div>
</div></div>
<button class="btn" style="margin-bottom:8px;" onclick="generateMiniMarker()">🔥 BUAT MINI MARKER</button>
      <button class="btn btn-secondary" style="margin-bottom:12px;" onclick="loadSampleData()">✨ COBA CONTOH POLA</button>

      <div id="resultArea" class="card hidden" style="border-color:var(--neon-pink);">
        <div id="cwSwipeBar" class="hidden" style="display:flex; align-items:center; justify-content:space-between; background:#090814; padding:8px 10px; border-radius:10px; margin-bottom:8px; border:1px solid var(--neon-cyan);">
          <button type="button" onclick="navigateColorway(-1)" style="background:var(--card); color:var(--neon-cyan); border:1px solid var(--neon-cyan); border-radius:8px; padding:6px 12px; font-weight:900;">◀</button>
          <div id="cwSwipeLabel" style="font-size:11px; font-weight:800; color:var(--neon-yellow);">Colorway 1/1</div>
          <button type="button" onclick="navigateColorway(1)" style="background:var(--card); color:var(--neon-cyan); border:1px solid var(--neon-cyan); border-radius:8px; padding:6px 12px; font-weight:900;">▶</button>
        </div>
        <button type="button" class="btn btn-pink" style="margin-bottom:8px;" onclick="openFullPreview()">⛶ PREVIEW 1 LAYAR PENUH</button>
        <button type="button" class="btn" style="margin-bottom:8px; background:linear-gradient(90deg, #ff007f, #fee440); color:#07060e;" id="btnGoToMenu2" onclick="openToolMode('autosync')">⚡ LANJUT KE MENU 2: AUTO SYNC &rarr;</button>
        <div id="previewViewport" style="width:100%; overflow:hidden; background:#05040a; border:1.5px solid var(--neon-purple); border-radius:10px; margin-bottom:10px;">
          <div id="markerContainer" style="width:100%;"></div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
          <button class="btn" onclick="exportAllPDF()">📄 DOWNLOAD PDF</button>
          <button class="btn btn-secondary" onclick="exportAllPNG()">🖼️ DOWNLOAD PNG</button>
        </div>
        <button class="btn btn-pink" onclick="saveAllColorwaysBatch()">📁 SAVE SEMUA COLORWAY (ORDER NO)</button>
      </div>
      <div class="card">
        <div class="card-row" style="margin-bottom:8px;">
          <div class="card-title">💾 Riwayat &amp; Backup JSON</div>
          <div style="display:flex; gap:6px;">
            <button type="button" onclick="backupData()" style="background:rgba(0,245,212,0.15); color:var(--neon-cyan); border:1px solid var(--neon-cyan); border-radius:8px; padding:5px 9px; font-size:11px; font-weight:800;">⬇️ BACKUP</button>
            <button type="button" onclick="document.getElementById('restoreInput').click()" style="background:rgba(255,0,127,0.15); color:var(--neon-pink); border:1px solid var(--neon-pink); border-radius:8px; padding:5px 9px; font-size:11px; font-weight:800;">⬆️ RESTORE</button>
            <input type="file" id="restoreInput" accept=".json,.zip" class="hidden" onchange="restoreData(event)" />
          </div>
        </div>
        <div id="historyList"></div>
      </div>
    </div>

    <div id="panelManual" class="hidden">
      <div id="dynamicProcessColorsBox" class="card" style="border-color:var(--neon-pink); margin-bottom:12px;">
        <div class="card-title" style="color:var(--neon-pink);">🏷️ LUAR LINE</div>
        <div class="card-sub" style="margin-bottom:8px;">Proses luar line terdeteksi dari DXF (dipisah tanda "-"). Atur warna (dilarang hitam):</div>
        <div id="dynamicProcessColors" style="display:flex; flex-direction:column; gap:8px;">
          <div class="card-sub">Klik "Buat Mini Marker" terlebih dahulu untuk memunculkan proses.</div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">✏️ Edit Nama Pattern &amp; Fabric</div>
        <div id="pieceMappingList" style="margin-top:10px; max-height:320px; overflow-y:auto;">
          <div class="card-sub">Belum ada file DXF yang dimuat.</div>
        </div>
      </div>
      <button class="btn" onclick="generateMiniMarker()">🔥 TERAPKAN &amp; BUAT MINI MARKER</button>
    </div>

        <div id="panelDownloads" class="hidden">
      <div class="card" style="border-color:var(--neon-cyan);">
        <div class="card-row" style="margin-bottom:8px;">
          <div class="card-title">📥 RIWAYAT &amp; AKSES FILE DOWNLOAD</div>
          <button type="button" onclick="clearDownloadRegistry()" style="background:rgba(255,0,127,0.18); color:var(--neon-pink); border:1px solid var(--neon-pink); border-radius:6px; padding:4px 8px; font-size:10px; font-weight:800; cursor:pointer;">🗑️ BERSIHKAN</button>
        </div>
        <div class="card-sub" style="margin-bottom:10px;">Lokasi folder: <strong style="color:var(--neon-yellow);">Penyimpanan Internal / Download / MiniMarker</strong> (HP) atau <strong style="color:var(--neon-yellow);">Downloads</strong> (PC). Ketuk tombol di bawah untuk membuka/mengunduh ulang file secara langsung:</div>
        <div id="downloadRegistryList"></div>
      </div>
    </div>

    <div id="floatingActionBar" style="position:fixed; bottom:0; left:0; right:0; z-index:900; background:rgba(11, 9, 26, 0.94); backdrop-filter:blur(8px); border-top:1.5px solid var(--neon-cyan); padding:10px 12px; display:flex; gap:8px; box-shadow:0 -4px 20px rgba(0, 245, 212, 0.25);">
      <button type="button" class="btn btn-secondary" style="flex:1; padding:11px 8px; font-size:12px; margin:0;" onclick="openSaveScopeModal()">💾 SIMPAN PERUBAHAN</button>
      <button type="button" class="btn" style="flex:1.2; padding:11px 8px; font-size:12px; margin:0;" onclick="generateMiniMarker()">🔥 BUAT MINI MARKER</button>
    </div>
  </div>

  <!-- MODAL 1 LAYAR PENUH -->
  <div id="fullScreenModal" class="hidden" style="position:fixed; inset:0; z-index:9999; background:#05040a; display:none; flex-direction:column;">
    <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 12px; background:#110f21; border-bottom:1.5px solid var(--neon-cyan); gap:6px;">
      <button type="button" onclick="navigateColorway(-1)" style="background:#07060e; color:var(--neon-cyan); border:1.5px solid var(--neon-cyan); border-radius:8px; padding:6px 12px; font-weight:900;">◀</button>
      <div id="fsColorwayTitle" style="flex:1; text-align:center; font-size:12px; font-weight:800; color:var(--neon-yellow); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Colorway</div>
      <button type="button" onclick="navigateColorway(1)" style="background:#07060e; color:var(--neon-cyan); border:1.5px solid var(--neon-cyan); border-radius:8px; padding:6px 12px; font-weight:900;">▶</button>
      <button type="button" onclick="closeFullPreview()" style="background:var(--neon-pink); color:#fff; border:none; border-radius:8px; padding:6px 12px; font-weight:900;">✕ TUTUP</button>
    </div>
    <div id="fsViewport" style="flex:1; width:100%; height:100%; overflow:hidden; position:relative; touch-action:none; display:flex; align-items:center; justify-content:center;">
      <div id="fsCanvasHolder" style="transform-origin:center center; transition:transform 0.1s ease-out; display:flex; align-items:center; justify-content:center;"></div>
    </div>
    <div style="display:flex; gap:6px; padding:10px 12px; background:#110f21; border-top:1.5px solid var(--neon-pink);">
      <button type="button" onclick="fsZoom(-0.4)" style="flex:1; background:#07060e; color:var(--neon-cyan); border:1px solid var(--neon-cyan); border-radius:8px; padding:9px; font-weight:900;">🔍 -</button>
      <button type="button" onclick="fsReset()" id="fsZoomText" style="flex:1.2; background:#07060e; color:var(--neon-yellow); border:1px solid var(--neon-yellow); border-radius:8px; padding:9px; font-weight:900;">100%</button>
      <button type="button" onclick="fsZoom(0.4)" style="flex:1; background:#07060e; color:var(--neon-cyan); border:1px solid var(--neon-cyan); border-radius:8px; padding:9px; font-weight:900;">🔍 +</button>
      <button type="button" onclick="fsRotate()" style="flex:1.3; background:var(--neon-pink); color:#fff; border:none; border-radius:8px; padding:9px; font-weight:900;">🔄 ROTATE</button>
    </div>
  </div>
  <script>
try { localStorage.removeItem("mm_live_app_js"); } catch(e) {}
</script>
<script src="app.js"></script>
  <div id="quickEditModal" class="hidden" style="position:fixed; inset:0; z-index:999999; background:rgba(5,4,15,0.88); backdrop-filter:blur(6px); display:none; align-items:center; justify-content:center; padding:16px;">
    <div style="width:100%; max-width:380px; background:#141226; border:1.5px solid var(--neon-cyan); border-radius:14px; padding:16px; box-shadow:0 12px 32px rgba(0,245,212,0.25);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
        <div style="font-size:14px; font-weight:900; color:var(--neon-cyan);">✏️ EDIT TULISAN PATTERN</div>
        <button type="button" onclick="closeQuickPatternEditor()" style="background:transparent; border:none; color:#f87171; font-size:18px; font-weight:bold; cursor:pointer;">✕</button>
      </div>
      <input type="hidden" id="qePieceIdx" />
      <label style="font-size:11px; color:var(--muted);">NAMA PATTERN:</label>
      <input type="text" id="qeName" style="margin-bottom:8px; font-weight:700;" onkeydown="if(event.key==='Enter'){event.preventDefault();saveQuickPatternEdit();}" />
      <label style="font-size:11px; color:var(--muted);">UKURAN:</label>
      <input type="text" id="qeSize" style="margin-bottom:8px;" onkeydown="if(event.key==='Enter'){event.preventDefault();saveQuickPatternEdit();}" />
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
        <div>
          <label style="font-size:11px; color:var(--muted);">FABRIC:</label>
          <select id="qeFabric">
            <option value="MA">MA</option><option value="T1">T1</option><option value="T2">T2</option>
            <option value="T3">T3</option><option value="L2">L2</option><option value="N1">N1</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px; color:var(--muted);">QTY / PAIR:</label>
          <input type="text" id="qeQty" list="qeQtyList" placeholder="1x / A/B / ketik..." onkeydown="if(event.key==='Enter'){event.preventDefault();saveQuickPatternEdit();}" />
          <datalist id="qeQtyList">
            <option value="A/B"><option value="Ax2 Bx2"><option value="X2"><option value="X3"><option value="X4"><option value="X6"><option value="X8">
          </datalist>
        </div>
      </div>
      <label style="font-size:11px; color:var(--muted);">PROSES LUAR LINE (PILIH ATAU KETIK MANUAL):</label>
      <input type="text" id="qeProc" list="qeProcList" placeholder="Kosongkan atau ketik (misal: OCM-BORDIR)" style="margin-bottom:12px; color:var(--neon-yellow); font-weight:700;" onkeydown="if(event.key==='Enter'){event.preventDefault();saveQuickPatternEdit();}" />
      <datalist id="qeProcList">
        <option value="OCM"><option value="BORDIR"><option value="AUTOMATION-OCM">
        <option value="OCM-BORDIR"><option value="AUTOMATION"><option value="HEAT EMBOSSED"><option value="SILKSCREEN">
      </datalist>
      <div style="display:flex; gap:8px;">
        <button type="button" class="btn btn-secondary" style="flex:1; margin:0; padding:10px;" onclick="closeQuickPatternEditor()">BATAL</button>
        <button type="button" class="btn" style="flex:1.4; margin:0; padding:10px;" onclick="saveQuickPatternEdit()">💾 TERAPKAN</button>
      </div>
    </div>
  </div>
<script>if("serviceWorker" in navigator){navigator.serviceWorker.register("sw.js");}</script>
  <div id="saveScopeModal" class="hidden" style="position:fixed; inset:0; z-index:999999; background:rgba(5,4,15,0.88); backdrop-filter:blur(6px); display:none; align-items:center; justify-content:center; padding:16px;">
    <div style="width:100%; max-width:370px; background:#141226; border:1.5px solid var(--neon-cyan); border-radius:14px; padding:18px; box-shadow:0 12px 32px rgba(0,245,212,0.28); text-align:center;">
      <div style="font-size:15px; font-weight:900; color:var(--neon-cyan); margin-bottom:6px;">💾 SIMPAN PERUBAHAN</div>
      <div style="font-size:12px; color:var(--muted); margin-bottom:14px; line-height:1.45;">Pilih cakupan penerapan hasil editan pattern &amp; pengaturan lembar ini:</div>
      <div style="display:flex; flex-direction:column; gap:9px;">
        <button type="button" class="btn" style="margin:0; padding:12px; font-size:13px;" onclick="applySaveWithScope('current')">🎨 SIMPAN UNTUK COLOR INI SAJA</button>
        <button type="button" class="btn btn-pink" style="margin:0; padding:12px; font-size:13px;" onclick="applySaveWithScope('all')">🌍 SIMPAN UNTUK SEMUA COLOR</button>
        <button type="button" class="btn btn-secondary" style="margin:0; padding:9px; font-size:12px;" onclick="closeSaveScopeModal()">BATAL</button>
      </div>
    </div>
  </div>
  <div id="exportFormatModal" class="hidden" style="position:fixed; inset:0; z-index:999999; background:rgba(5,4,15,0.88); backdrop-filter:blur(6px); display:none; align-items:center; justify-content:center; padding:16px;">
    <div style="width:100%; max-width:360px; background:#141226; border:1.5px solid var(--neon-cyan); border-radius:14px; padding:18px; box-shadow:0 12px 32px rgba(0,245,212,0.28); text-align:center;">
      <div style="font-size:15px; font-weight:900; color:var(--neon-cyan); margin-bottom:6px;">💾 PILIH FORMAT SIMPAN / DOWNLOAD</div>
      <div style="font-size:12px; color:#cbd5e1; margin-bottom:14px;">Pilih format file untuk seluruh colorway di dalam folder ZIP:</div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px;">
        <button type="button" class="btn" style="margin:0; padding:12px 8px; font-size:13px;" onclick="confirmBatchFormat('pdf')">📄 FORMAT PDF</button>
        <button type="button" class="btn btn-pink" style="margin:0; padding:12px 8px; font-size:13px;" onclick="confirmBatchFormat('png')">🖼️ FORMAT PNG</button>
      </div>
      <button type="button" class="btn btn-secondary" style="margin:0; padding:9px; font-size:12px;" onclick="closeExportFormatModal()">BATAL</button>
    </div>
  </div>
</body>
</html>
